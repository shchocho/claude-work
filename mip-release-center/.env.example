# Copy to .env and adjust. Every setting is optional; the values shown are the defaults.

# --- Server -----------------------------------------------------------------
MRC_PORT=8080
MRC_HOST=127.0.0.1
# Address users open in the browser; used in links sent to webhooks.
MRC_BASE_URL=http://localhost:8080
MRC_DATA_DIR=./data
MRC_LOG_LEVEL=info

# --- Sign-in ----------------------------------------------------------------
# local  = login and password kept in this app
# header = identity asserted by your SSO reverse proxy (needs MRC_TRUST_PROXY=true)
MRC_AUTH_MODE=local
MRC_AUTH_HEADER=x-forwarded-email
MRC_AUTH_NAME_HEADER=x-forwarded-preferred-username
MRC_SSO_AUTO_PROVISION=true
# First start with an empty database creates this administrator. Leave the
# password empty to have a temporary one generated and printed once.
MRC_ADMIN_LOGIN=admin
MRC_ADMIN_PASSWORD=

# --- Behind a reverse proxy ---------------------------------------------------
MRC_TRUST_PROXY=false
MRC_TRUSTED_PROXIES=127.0.0.1,::1
# auto = Secure cookies whenever the request arrived over HTTPS
MRC_COOKIE_SECURE=auto

# --- Sessions and passwords ---------------------------------------------------
MRC_SESSION_IDLE_MINUTES=30
MRC_SESSION_MAX_HOURS=12
MRC_PASSWORD_MIN_LENGTH=10
MRC_LOGIN_MAX_FAILURES=5
MRC_LOGIN_LOCK_MINUTES=15

# --- Executor (optional) ------------------------------------------------------
# Endpoint your organisation runs to carry out approved requests with its own
# rights. Set both, then choose "실행기 연동" in 정책 > 규칙·실행.
MRC_EXECUTOR_WEBHOOK_URL=
MRC_EXECUTOR_WEBHOOK_SECRET=

# --- Notifications (optional) -------------------------------------------------
# Every in-app notification is also POSTed here so you can forward it to mail or chat.
MRC_NOTIFY_WEBHOOK_URL=
MRC_NOTIFY_WEBHOOK_SECRET=

# --- Demo ---------------------------------------------------------------------
# Sample organisation with a shared, published password. Never on a real network.
MRC_DEMO=false
